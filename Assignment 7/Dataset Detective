
names = ["A", "B", "C", "D", "E"]
marks = [85, 90, 78, 92, 88]
study_hours = [3, 4, 2, 5, 4]
sleep_hours = [7, 6, 8, 5, 7]

# display top rows
print("Top Rows:")
for i in range(len(names)):
    print(names[i], marks[i], study_hours[i], sleep_hours[i])

# highest value column
print("\nHighest Values:")
print("Marks:", max(marks))
print("Study Hours:", max(study_hours))
print("Sleep Hours:", max(sleep_hours))

# missing values count
missing = 0
for i in range(len(names)):
    if names[i] == "" or marks[i] == "" or study_hours[i] == "" or sleep_hours[i] == "":
        missing += 1

print("\nMissing Values:", missing)
