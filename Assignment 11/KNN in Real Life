import math

# user preferences
A = [5,3]
B = [4,2]
C = [1,5]

new_user = [5,3]

def distance(p1, p2):
    return math.sqrt((p1[0]-p2[0])**2 + (p1[1]-p2[1])**2)

print("Distance from A:", distance(new_user, A))
print("Distance from B:", distance(new_user, B))
print("Distance from C:", distance(new_user, C))
