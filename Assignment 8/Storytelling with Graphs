students = ["A", "B", "C", "D", "E"]
marks = [85, 90, 78, 92, 88]

# BAR CHART
print("BAR CHART")
for i in range(len(students)):
    print(students[i], "|" , "*" * (marks[i]//2))

# PIE CHART (percentage)
print("\nPIE CHART (Percentage)")
total = sum(marks)
for i in range(len(students)):
    percent = (marks[i]/total)*100
    print(students[i], ":", round(percent,2), "%")

# HISTOGRAM
print("\nHISTOGRAM")
ranges = ["70-79", "80-89", "90-100"]
count = [0,0,0]

for m in marks:
    if 70 <= m <= 79:
        count[0] += 1
    elif 80 <= m <= 89:
        count[1] += 1
    elif 90 <= m <= 100:
        count[2] += 1

for i in range(len(ranges)):
    print(ranges[i], "|" , "*" * count[i])
